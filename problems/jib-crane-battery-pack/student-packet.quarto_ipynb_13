        "---\n",
        "title: \"Student Packet — Wall-Mounted Swing-Jib Crane\"\n",
        "subtitle: \"Battery-Pack Handling on an Automotive Assembly Line\"\n",
        "author: \"Context-Rich Mechanics of Materials Library\"\n",
